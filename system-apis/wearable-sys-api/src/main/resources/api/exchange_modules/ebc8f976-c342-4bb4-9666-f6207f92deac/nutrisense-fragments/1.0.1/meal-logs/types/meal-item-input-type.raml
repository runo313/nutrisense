#%RAML 1.0 DataType
type: object
displayName: MealItemInput
description: Input shape for a meal item. Mode A uses foodId plus portionId and portionAmount. Mode B uses foodId plus quantityG directly. Providing both modes or neither returns a 400.
properties:
  foodId:
    type: integer
    description: Reference to the food from the Nutrition System API
  portionId:
    type: integer
    required: false
    description: Mode A only. Reference to the portion from the Nutrition System API
  portionAmount:
    type: number
    required: false
    description: Mode A only. Multiplier applied to the portion gram weight to compute quantityG
  quantityG:
    type: number
    required: false
    description: Mode B only. Direct gram weight of the food consumed
example:
  foodId: 747448
  portionId: 118808
  portionAmount: 1.5