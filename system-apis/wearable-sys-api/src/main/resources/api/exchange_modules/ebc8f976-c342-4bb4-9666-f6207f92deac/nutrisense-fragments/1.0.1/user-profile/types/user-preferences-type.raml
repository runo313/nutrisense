#%RAML 1.0 DataType
type: object
displayName: UserPreferences
description: User preferences for insights, metrics and meal timing
properties:
  preferenceId:
    type: string
    description: UUID of the preferences record generated by the database
  userId:
    type: string
    description: Identifier of the user these preferences belong to
  insightFrequency:
    type: string
    enum: [daily, weekly, both]
    description: How frequently the user wants to receive insights
  preferredWearableMetrics:
    type: array
    required: false
    description: Wearable metrics the user wants to track
    items:
      type: !include wearable-metric-preference-type.raml
  preferredNutritionMetrics:
    type: array
    required: false
    description: Nutrition metrics the user wants to track
    items:
      type: !include nutrition-metric-preference-type.raml
  typicalBreakfastTime:
    type: time-only
    required: false
    description: User's typical breakfast time
  typicalLunchTime:
    type: time-only
    required: false
    description: User's typical lunch time
  typicalDinnerTime:
    type: time-only
    required: false
    description: User's typical dinner time
  typicalSleepTime:
    type: time-only
    required: false
    description: User's typical sleep time
  targetSleepDurationHrs:
    type: number
    required: false
    description: User's target sleep duration in hours
  unitsSystem:
    type: string
    enum: [metric, imperial]
    description: Preferred unit system for displaying measurements
  createdAt:
    type: datetime
    description: Timestamp when preferences were first created
  updatedAt:
    type: datetime
    description: Timestamp when preferences were last updated
example:
  preferenceId: "d4e5f6a7-b8c9-0123-defa-234567890123"
  userId: "runo313"
  insightFrequency: "daily"
  preferredWearableMetrics: ["heart_rate", "sleep", "steps"]
  preferredNutritionMetrics: ["protein", "energy_kcal"]
  typicalBreakfastTime: "08:00:00"
  typicalLunchTime: "12:30:00"
  typicalDinnerTime: "19:00:00"
  typicalSleepTime: "23:00:00"
  targetSleepDurationHrs: 7.5
  unitsSystem: "metric"
  createdAt: "2026-07-13T08:00:00-04:00"
  updatedAt: "2026-07-13T08:00:00-04:00"