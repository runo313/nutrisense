#%RAML 1.0 DataType
type: object
displayName: DietaryConstraint
description: A dietary constraint associated with a user
properties:
  constraintId:
    type: string
    description: UUID of the constraint generated by the database
  userId:
    type: string
    description: Identifier of the user this constraint belongs to
  constraintType:
    type: string
    enum: [allergy, intolerance, preference]
    description: Type of dietary constraint
  constraintValue:
    type: string
    enum: [gluten, dairy, nuts, shellfish, eggs, soy, meat, pork, alcohol, vegetarian, vegan, halal, kosher, gluten_free]
    description: The specific dietary constraint
  severity:
    type: string
    enum: [strict, moderate, preferred]
    description: Severity level of the constraint
  isActive:
    type: boolean
    description: Whether this constraint is currently active
  createdAt:
    type: datetime
    description: Timestamp when this constraint was recorded
example:
  constraintId: "c3d4e5f6-a7b8-9012-cdef-123456789012"
  userId: "runo313"
  constraintType: "allergy"
  constraintValue: "gluten"
  severity: "strict"
  isActive: true
  createdAt: "2026-07-13T08:00:00-04:00"