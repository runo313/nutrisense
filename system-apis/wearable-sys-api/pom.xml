<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>ebc8f976-c342-4bb4-9666-f6207f92deac</groupId>
	<artifactId>wearable-sys-api-app</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>mule-application</packaging>

	<name>wearable-sys-api</name>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

		<app.runtime>4.11.0</app.runtime>
		<mule.maven.plugin.version>4.7.0</mule.maven.plugin.version>
		<munit.version>3.7.0</munit.version>
		
		<anypoint.uri>https://anypoint.mulesoft.com</anypoint.uri>
		<deploy.applicationName>wearable-sys-api</deploy.applicationName>
	</properties>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-clean-plugin</artifactId>
				<version>3.2.0</version>
			</plugin>

			<plugin>
				<groupId>org.mule.tools.maven</groupId>
				<artifactId>mule-maven-plugin</artifactId>
				<version>${mule.maven.plugin.version}</version>
				<extensions>true</extensions>
				<configuration>
					<classifier>mule-application</classifier>
					<sharedLibraries>
						<sharedLibrary>
							<groupId>org.postgresql</groupId>
							<artifactId>postgresql</artifactId>
						</sharedLibrary>
						<sharedLibrary>
							<groupId>com.splunk.logging</groupId>
							<artifactId>splunk-library-javalogging</artifactId>
						</sharedLibrary>
					</sharedLibraries>
				</configuration>
			</plugin>

			<plugin>
				<groupId>com.mulesoft.munit.tools</groupId>
				<artifactId>munit-maven-plugin</artifactId>
				<version>${munit.version}</version>
				<executions>
					<execution>
						<id>test</id>
						<phase>test</phase>
						<goals>
							<goal>test</goal>
							<goal>coverage-report</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<coverage>
						<runCoverage>true</runCoverage>
						<formats>
							<format>html</format>
						</formats>
					</coverage>
				</configuration>
			</plugin>
		</plugins>
	</build>
	
	<profiles>
		<profile>
			<id>dev</id>
			<properties>
				<environment>dev</environment>
				<deployEnv>dev</deployEnv>
				<arm.muleVersion>4.13.2</arm.muleVersion>
				<arm.target>nutrisense-dev-server</arm.target>
				<arm.targetType>server</arm.targetType>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.mule.tools.maven</groupId>
						<artifactId>mule-maven-plugin</artifactId>
						<configuration>
							<armDeployment>
								<uri>${anypoint.uri}</uri>
								<muleVersion>${arm.muleVersion}</muleVersion>
								<target>${arm.target}</target>
								<targetType>${arm.targetType}</targetType>
								<environment>${environment}</environment>
								<applicationName>${deploy.applicationName}</applicationName>
								<businessGroupId>${ANYPOINT_ORG_ID}</businessGroupId>
								<connectedAppClientId>${ANYPOINT_CLIENT_ID}</connectedAppClientId>
								<connectedAppClientSecret>${ANYPOINT_CLIENT_SECRET}</connectedAppClientSecret>
								<connectedAppGrantType>client_credentials</connectedAppGrantType>
								<properties>
									<env>${deployEnv}</env>
									<anypoint.platform.client_id>${ANYPOINT_ENV_CLIENT_ID}</anypoint.platform.client_id>
									<SPLUNK_URL>${SPLUNK_URL}</SPLUNK_URL>
								</properties>
							</armDeployment>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>

		<profile>
			<id>test</id>
			<properties>
				<environment>test</environment>
				<deployEnv>test</deployEnv>
				<ch2.muleVersion>4.12.2</ch2.muleVersion>
				<ch2.target>Cloudhub-US-East-2</ch2.target>
				<ch2.replicas>1</ch2.replicas>
				<ch2.vCores>0.1</ch2.vCores>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.mule.tools.maven</groupId>
						<artifactId>mule-maven-plugin</artifactId>
						<configuration>
							<cloudhub2Deployment>
								<uri>${anypoint.uri}</uri>
								<provider>MC</provider>
								<environment>${environment}</environment>
								<target>${ch2.target}</target>
								<muleVersion>${ch2.muleVersion}</muleVersion>
								<applicationName>${deploy.applicationName}</applicationName>
								<businessGroupId>${ANYPOINT_ORG_ID}</businessGroupId>
								<connectedAppClientId>${ANYPOINT_CLIENT_ID}</connectedAppClientId>
								<connectedAppClientSecret>${ANYPOINT_CLIENT_SECRET}</connectedAppClientSecret>
								<connectedAppGrantType>client_credentials</connectedAppGrantType>
								<replicas>${ch2.replicas}</replicas>
								<vCores>${ch2.vCores}</vCores>
								<deploymentSettings>
									<generateDefaultPublicUrl>true</generateDefaultPublicUrl>
								</deploymentSettings>
								<properties>
									<env>${deployEnv}</env>
									<anypoint.platform.client_id>${ANYPOINT_ENV_CLIENT_ID}</anypoint.platform.client_id>
									<SPLUNK_URL>${SPLUNK_URL}</SPLUNK_URL>
								</properties>
								<secureProperties>
									<MULE_MASTER_KEY>${MULE_MASTER_KEY}</MULE_MASTER_KEY>
									<anypoint.platform.client_secret>${ANYPOINT_ENV_CLIENT_SECRET}</anypoint.platform.client_secret>
									<SPLUNK_HEC_TOKEN>${SPLUNK_HEC_TOKEN}</SPLUNK_HEC_TOKEN>
								</secureProperties>
							</cloudhub2Deployment>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>

	</profiles>

	<dependencies>
		<dependency>
			<groupId>org.mule.connectors</groupId>
			<artifactId>mule-http-connector</artifactId>
			<version>1.11.1</version>
			<classifier>mule-plugin</classifier>
		</dependency>
		<dependency>
			<groupId>org.mule.connectors</groupId>
			<artifactId>mule-sockets-connector</artifactId>
			<version>1.2.7</version>
			<classifier>mule-plugin</classifier>
		</dependency>
		<dependency>
			<groupId>org.mule.modules</groupId>
			<artifactId>mule-apikit-module</artifactId>
			<version>1.11.11</version>
			<classifier>mule-plugin</classifier>
		</dependency>
		<dependency>
			<groupId>com.mulesoft.modules</groupId>
			<artifactId>mule-secure-configuration-property-module</artifactId>
			<version>1.3.1</version>
			<classifier>mule-plugin</classifier>
		</dependency>
		<dependency>
			<groupId>org.mule.connectors</groupId>
			<artifactId>mule-db-connector</artifactId>
			<version>1.15.0</version>
			<classifier>mule-plugin</classifier>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<version>42.7.11</version>
		</dependency>
		<dependency>
			<groupId>org.mule.modules</groupId>
			<artifactId>mule-validation-module</artifactId>
			<version>2.0.8</version>
			<classifier>mule-plugin</classifier>
		</dependency>
		<dependency>
			<groupId>com.mulesoft.munit</groupId>
			<artifactId>munit-runner</artifactId>
			<version>3.7.0</version>
			<classifier>mule-plugin</classifier>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.mulesoft.munit</groupId>
			<artifactId>munit-tools</artifactId>
			<version>3.7.0</version>
			<classifier>mule-plugin</classifier>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.mule.weave</groupId>
			<artifactId>assertions</artifactId>
			<version>1.2.1</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.splunk.logging</groupId>
			<artifactId>splunk-library-javalogging</artifactId>
			<version>1.11.10</version>
		</dependency>
	</dependencies>

	<repositories>
		<repository>
			<id>anypoint-exchange-v3</id>
			<name>Anypoint Exchange</name>
			<url>https://maven.anypoint.mulesoft.com/api/v3/maven</url>
			<layout>default</layout>
		</repository>
		<repository>
			<id>mulesoft-releases</id>
			<name>MuleSoft Releases Repository</name>
			<url>https://repository.mulesoft.org/nexus/repository/releases/</url>
			<layout>default</layout>
		</repository>
		<repository>
			<id>splunk-artifactory</id>
			<name>Splunk Releases</name>
			<url>https://splunk.jfrog.io/splunk/ext-releases-local</url>
		</repository>
	</repositories>

	<pluginRepositories>
		<pluginRepository>
			<id>mulesoft-releases</id>
			<name>MuleSoft Releases Repository</name>
			<layout>default</layout>
			<url>https://repository.mulesoft.org/nexus/repository/releases/</url>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
		</pluginRepository>
	</pluginRepositories>

	<distributionManagement>
		<repository>
			<id>anypoint-exchange-v3</id>
			<name>Corporate Repository</name>
			<url>https://maven.anypoint.mulesoft.com/api/v3/organizations/ebc8f976-c342-4bb4-9666-f6207f92deac/maven</url>
			<layout>default</layout>
		</repository>
	</distributionManagement>

</project>