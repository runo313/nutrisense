#%RAML 1.0 DataType
type: object
displayName: UserCondition
description: A medical condition associated with a user
properties:
  conditionId:
    type: string
    description: UUID of the condition generated by the database
  userId:
    type: string
    description: Identifier of the user this condition belongs to
  conditionType:
    type: string
    enum: [type2_diabetes, prediabetes, hypertension, high_cholesterol, anemia, celiac_disease, ibs, gerd, kidney_disease]
    description: Type of medical condition
  managementStatus:
    type: string
    enum: [monitoring, diet_controlled, medication_managed, in_remission]
    description: Current management status of the condition
  diagnosedAt:
    type: date-only
    required: false
    description: Date when the condition was diagnosed. Nullable if unknown
  notes:
    type: string
    required: false
    description: Free text notes about the condition
  isActive:
    type: boolean
    description: Whether this condition is currently active
  createdAt:
    type: datetime
    description: Timestamp when this condition was recorded
example:
  conditionId: "b2c3d4e5-f6a7-8901-bcde-f12345678901"
  userId: "runo313"
  conditionType: "hypertension"
  managementStatus: "diet_controlled"
  diagnosedAt: "2022-03-15"
  notes: "Monitoring blood pressure weekly"
  isActive: true
  createdAt: "2026-07-13T08:00:00-04:00"