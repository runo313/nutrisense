#%RAML 1.0 DataType
type: object
displayName: MealsResponse
description: Response GET meal list endpoints
properties:
  count:
    type: integer
    description: Number of meals returned in this response
  meals:
    type: array
    description: List of meals matching the query with all non-deleted items included
    items: !include meal-type.raml
example:
  count: 2
  meals:
    - mealId: "b2c3d4e5-f6a7-8901-bcde-f12345678901"
      userId: "runo313"
      mealType: "breakfast"
      consumedAt: "2026-07-13T08:00:00-04:00"
      loggedAt: "2026-07-13T08:30:00-04:00"
      items:
        - itemId: "a1b2c-e5f6-7890-abcd"
          foodId: 747448
          portionId: 118808
          portionAmount: 1.5
          quantityG: 234.0
          loggedAt: "2026-07-13T08:30:00-04:00"
    - mealId: "c3d4-a7b8-9012-cdef-"
      userId: "runo313"
      mealType: "lunch"
      consumedAt: "2026-07-13T12:30:00-04:00"
      loggedAt: "2026-07-13T12:45:00-04:00"
      items:
        - itemId: "d4e5f-b8c9-0123-defa"
          foodId: 2684444
          quantityG: 150.0
          loggedAt: "2026-07-13T12:45:00-04:00"