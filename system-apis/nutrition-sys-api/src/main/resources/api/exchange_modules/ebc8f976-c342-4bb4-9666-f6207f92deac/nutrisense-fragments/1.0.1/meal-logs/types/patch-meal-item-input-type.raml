#%RAML 1.0 DataType
type: object
displayName: PatchMealItemInput
description: Request body for partially updating a meal item. At least one field must be provided.
properties:
  foodId:
    type: integer
    required: false
    description: Updated food reference
  portionId:
    type: integer
    required: false
    description: Updated portion reference.
  portionAmount:
    type: number
    required: false
    description: Updated portion multiplier.
  quantityG:
    type: number
    required: false
    description: Updated direct gram weight. 
example:
  portionAmount: 2.0