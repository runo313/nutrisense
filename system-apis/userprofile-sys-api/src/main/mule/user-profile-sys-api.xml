    </flow>
    <flow name="patch:\profiles\(userId):application\json:user-profile-sys-api-config">
        <flow-ref doc:name="patch-profile-flow" doc:id="fc3ecca7-d810-46d0-bf8a-f27432300843" name="patch-profile-flow"/>
    </flow>
    <flow name="get:\profiles\(userId)\conditions:user-profile-sys-api-config">
        <flow-ref doc:name="get-conditions-flow" doc:id="3bc04008-e416-4b7f-9177-c3ee392a416a" name="get-conditions-flow"/>
    </flow>
    <flow name="get:\profiles\(userId)\constraints:user-profile-sys-api-config">
        <flow-ref doc:name="get-constraints-flow" doc:id="69bd6c4a-cf41-437f-86d8-882dff519331" name="get-constraints-flow"/>
    </flow>
    <flow name="get:\profiles\(userId)\goals:user-profile-sys-api-config">
        <flow-ref doc:name="get-goals-flow" doc:id="8a88a9d9-345a-44d2-affc-62a914465ecc" name="get-goals-flow"/>
    </flow>
    <flow name="get:\health:user-profile-sys-api-config">
        <ee:transform doc:name="Transform Message">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  status: "UP",
  timestamp: "2026-06-21T12:00:00Z"
} as Object {encoding: "UTF-8", mediaType: "application/json"}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>
    <flow name="get:\profiles\(userId)\preferences:user-profile-sys-api-config">
        <flow-ref doc:name="get-preferences-flow" doc:id="fab6fc2f-d2ec-49fb-af5e-a15837a605bc" name="get-preferences-flow"/>
    </flow>
    <flow name="get:\profiles\(userId):user-profile-sys-api-config">
        <flow-ref doc:name="get-profile-flow" doc:id="77705aa6-280c-408d-9529-45aa941765af" name="get-profile-flow"/>
    </flow>
    <flow name="post:\profiles\(userId)\conditions:application\json:user-profile-sys-api-config">
        <flow-ref doc:name="create-condition-flow" doc:id="54f88ee8-902c-4a0b-8831-9b67bb036431" name="create-condition-flow"/>
    </flow>
    <flow name="post:\profiles\(userId)\constraints:application\json:user-profile-sys-api-config">
        <flow-ref doc:name="create-constraint-flow" doc:id="b7d7bef1-3b8e-44e0-881b-bb7d876a4854" name="create-constraint-flow"/>
    </flow>
    <flow name="post:\profiles\(userId)\goals:application\json:user-profile-sys-api-config">
        <flow-ref doc:name="create-goal-flow" doc:id="b6b5630e-b9b4-4371-8ed4-764001e371f5" name="create-goal-flow"/>
    </flow>
    <flow name="post:\profiles:application\json:user-profile-sys-api-config">
        <flow-ref doc:name="create-profile-flow" doc:id="987b4375-23d7-4c2f-a2b1-fa45b476f7ec" name="create-profile-flow"/>
    </flow>
</mule>
