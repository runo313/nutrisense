	<munit:test name="should_delete_constraint_and_return_204" doc:id="862028e9-ce48-4f28-a669-84c6d0156510" >
		<munit:behavior >
			<munit-tools:mock-when doc:name="Mock validate-profile-exists" doc:id="c1cb03ba-b2e0-44e6-ad5d-4407e6727556" processor="db:select" >
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="c3afebac-7e3d-4c04-bcc0-0fb7978c89d3" attributeName="doc:id" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:variables >
						<munit-tools:variable key="user_id" value='#["james2822"]' />
					</munit-tools:variables>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when doc:name="Mock Select Constraint Id" doc:id="852d8a14-c6cb-4031-b9a0-e8f5a3e9854d" processor="db:select">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="27c8168e-f458-44ae-9826-47c5cfaabe96" attributeName="doc:id" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value='#[%dw 2.0&#10;output appplication/java&#10;---&#10;[&#10;	{"constraint_id": "c3d4e5f6-a7b8-9012-cdef-123456789012"}&#10;]]' />
				</munit-tools:then-return>
