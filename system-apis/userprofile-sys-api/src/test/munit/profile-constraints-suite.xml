	<munit:config name="profile-constraints-suite.xml" />
	<munit:test name="should_create_constraint_and_return_201" doc:id="2313d971-083b-4895-b9b6-0bd02a1bc556" >
		<munit:behavior >
			<munit-tools:mock-when doc:name="Mock validate-profile-exists" doc:id="c794bb6a-6f26-4964-93d5-fd818baecce6" processor="db:select" >
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="c3afebac-7e3d-4c04-bcc0-0fb7978c89d3" attributeName="doc:id" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:variables >
						<munit-tools:variable key="user_id" value='#["james2822"]' />
					</munit-tools:variables>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when doc:name="Mock Insert Constraint" doc:id="0d479cad-f065-498f-8aa0-e3dd0d26c15d" processor="db:insert">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="16fccad3-160a-45e8-8274-cd4fba10a793" attributeName="doc:id" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:variables >
						<munit-tools:variable key="constraint_id" value='#["c3d4e5f6-a7b8-9012-cdef-123456789012"]' mediaType="application/java" />
					</munit-tools:variables>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when doc:name="Mock Select Constraint" doc:id="2aa701a2-aa54-4f47-a2b3-b35dd00f4519" processor="db:select">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="3f3ff9fc-5e8b-4355-b5b8-897cbff740ed" attributeName="doc:id" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value='#[MunitTools::getResourceAsString("payloads/constraint.json") read "application/json"]' mediaType="application/java" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution >
			<munit:set-event doc:name="Set Event" doc:id="4f414c8a-328b-413a-998a-269445e7b183" >
				<munit:payload value='#[%dw 2.0&#10;output application/java&#10;---&#10;{&#10;  constraintType: "allergy",&#10;  constraintValue: "gluten",&#10;  severity: "strict"&#10;}]' />
				<munit:attributes value='#[%dw 2.0&#10;output application/java&#10;---&#10;{&#10;  uriParams: {userId: "james2822"},&#10;  queryParams: {}&#10;}]' />
			</munit:set-event>
			<flow-ref doc:name="Flow Reference" doc:id="9ed72e58-d5d6-4c98-a925-768011653542" name="post:\profiles\(userId)\constraints:application\json:user-profile-sys-api-config"/>
		</munit:execution>
		<munit:validation >
			<munit-tools:assert-that doc:name="Assert that http status 201" doc:id="65595628-dafc-4cda-89b6-6e311e1198f9" expression="#[vars.httpStatus]" is="#[MunitTools::equalTo(201)]" />
			<munit-tools:assert-that doc:name="Assert that Constraint Value" doc:id="a0c82635-c981-4c9b-a1b0-4418d0432317" expression="#[payload.constraintValue]" is='#[MunitTools::equalTo("gluten")]' />
		</munit:validation>
	</munit:test>
