			<munit-tools:mock-when doc:name="Mock Delete Constraint" doc:id="686bac42-0eac-4da0-9b58-5e6cd6c0ee56" processor="db:delete">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="42cf53cc-f56c-4758-b722-cf9f902e97ab" attributeName="doc:id" />
				</munit-tools:with-attributes>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution >
			<munit:set-event doc:name="Set Event" doc:id="d39fb061-af15-416d-a89f-1f2baa4d7776" >
				<munit:attributes value='#[%dw 2.0&#10;output application/java&#10;---&#10;{&#10;  uriParams: {&#10;    userId: "james2822",&#10;    constraintId: "c3d4e5f6-a7b8-9012-cdef-123456789012"&#10;  },&#10;  queryParams: {}&#10;}]' />
			</munit:set-event>
			<flow-ref doc:name="Flow Reference" doc:id="21dbbebb-be16-45bb-b2ed-6ad20622a90c" name="delete-constraint-flow"/>
		</munit:execution>
		<munit:validation >
			<munit-tools:assert-that doc:name="Assert that http status 204" doc:id="cbc3e69c-f21e-4f4b-96c9-2f47b71913e7" expression="#[vars.httpStatus]" is="#[MunitTools::equalTo(204)]" />
		</munit:validation>
	</munit:test>
