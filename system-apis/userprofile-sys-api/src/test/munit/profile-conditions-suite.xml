				<munit-tools:then-return >
					<munit-tools:payload value='#[[{&#10;	user_id: "james2822"&#10;}]]' />
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when doc:name="Mock Select Condition Id" doc:id="469d8d7a-2682-46bb-9319-ac58324d6f3c" processor="db:select">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="b2b7cfda-12bd-4257-b976-7de4b3266689" attributeName="doc:id" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value="#[[]]" mediaType="application/java" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when doc:name="Mock Insert Condition" doc:id="d3a46de0-9ff3-4db7-830a-71748f195910" processor="db:insert">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="16e76912-7566-42e9-bb49-5bb2c22e63bb" attributeName="doc:id" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:variables >
						<munit-tools:variable key="conditionId" value='#[[{"condition_id": "b2c3d4e5-f6a7-8901-bcde-f12345678901"}]]' mediaType="application/java" />
					</munit-tools:variables>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when doc:name="Mock Select Condition" doc:id="8997349b-5953-41e4-8e44-623113953b11" processor="db:select">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="cfb241b6-2717-4515-bd67-a68ca1397a4f" attributeName="doc:id" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value='#[MunitTools::getResourceAsString("payloads/condition.json") read "application/json"]' />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution >
			<munit:set-event doc:name="Set Event" doc:id="96fa93dd-5dbc-4ac1-9be8-142560a12e43" >
				<munit:payload value='#[%dw 2.0&#10;output application/java&#10;---&#10;{&#10;  conditionType: "hypertension",&#10;  managementStatus: "diet_controlled",&#10;  diagnosedAt: "2022-03-15",&#10;  notes: "Monitoring blood pressure weekly"&#10;}]' />
				<munit:attributes value='#[%dw 2.0&#10;output application/java&#10;---&#10;{&#10;  uriParams: {userId: "james2822"},&#10;  queryParams: {}&#10;}]' />
			</munit:set-event>
			<flow-ref doc:name="Flow Reference" doc:id="5821e012-af49-439e-a48c-aced00a15284" name="post:\profiles\(userId)\conditions:application\json:user-profile-sys-api-config"/>
		</munit:execution>
		<munit:validation >
			<munit-tools:assert-that doc:name="Assert that http status 201" doc:id="fe320f2b-efc2-447f-b986-ec1445f8424a" expression="#[vars.httpStatus]" is="#[MunitTools::equalTo(201)]" />
			<munit-tools:assert-that doc:name="Assert Goal Type" doc:id="5796874f-716f-44a0-874e-579cfd1a0deb" expression="#[payload.conditionType]" is='#[MunitTools::equalTo("hypertension")]' />
		</munit:validation>
	</munit:test>
