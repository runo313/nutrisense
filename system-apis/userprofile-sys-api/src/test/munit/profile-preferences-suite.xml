	<munit:test name="should_upsert_preferences_insert_path_and_return_200" doc:id="d17a27b7-3027-4e3f-a83f-80579773e582" >
		<munit:behavior >
			<munit-tools:mock-when doc:name="Mock validate-profile-exists" doc:id="2c3df7d4-270c-4f1b-b636-71a76170fc70" processor="db:select" >
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="c3afebac-7e3d-4c04-bcc0-0fb7978c89d3" attributeName="doc:id" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:variables >
						<munit-tools:variable key="user_id" value='#["james2822"]' />
					</munit-tools:variables>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when doc:name="Mock Select User Id" doc:id="853e8095-f773-4c03-a405-5a08814c6f13" processor="db:select">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="05fc1f83-ff60-4191-82c6-71e7463014ef" attributeName="doc:id" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value="#[[]]" mediaType="application/java" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when doc:name="Mock Insert Preference" doc:id="ecc9e857-db0b-4def-94d7-867b90f53697" processor="db:insert">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="0cbaba3a-bb15-4153-a31f-a96985fff9a4" attributeName="doc:id" />
				</munit-tools:with-attributes>
			</munit-tools:mock-when>
			<munit-tools:mock-when doc:name="Mock Select User Preference" doc:id="d7fb49b1-36ab-4ed0-b9df-e6b7617067ee" processor="db:select">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="efaa39a5-bb94-4dda-8031-14b9a1d4a985" attributeName="doc:id" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value='#[MunitTools::getResourceAsString("payloads/preferences.json") read "application/json"]' />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution >
			<munit:set-event doc:name="Set Event" doc:id="16315295-3d52-4279-b3b8-1a2ee16338e0" >
				<munit:payload value='#[%dw 2.0&#10;output application/java&#10;---&#10;{&#10;  insightFrequency: "weekly",&#10;  preferredWearableMetrics: ["heart_rate", "hrv"],&#10;  unitsSystem: "imperial"&#10;}]' />
				<munit:attributes value='#[%dw 2.0&#10;output application/java&#10;---&#10;{&#10;  uriParams: {userId: "james2822"},&#10;  queryParams: {}&#10;}]' />
			</munit:set-event>
			<flow-ref doc:name="Flow Reference" doc:id="de2764e3-327a-438f-9aed-4a405fe390ee" name="patch:\profiles\(userId)\preferences:application\json:user-profile-sys-api-config"/>
		</munit:execution>
		<munit:validation >
			<munit-tools:assert-that doc:name="Assert that http status 201" doc:id="7badbb03-d4ea-4220-b027-9261ac98fdfe" expression="#[vars.httpStatus]" is="#[MunitTools::equalTo(201)]" />
			<munit-tools:assert-that doc:name="Assert that Constraint Value" doc:id="d18c253e-9508-47e1-ac9b-838e4d327271" expression="#[payload.insightFrequency]" is='#[MunitTools::equalTo("weekly")]' />
		</munit:validation>
	</munit:test>
