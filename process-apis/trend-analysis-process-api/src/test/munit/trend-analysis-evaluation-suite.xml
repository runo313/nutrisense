	<flow name="mock-get-food-response" doc:id="0e859821-d5ed-4ecd-b822-684a6375a593" >
		<set-variable value="#[payload as String]" doc:name="Set Variable" doc:id="dbed0b64-88be-41e8-b434-39694d3fb534" variableName="mockFoodId" />
		<choice doc:name="Validate foodId" doc:id="0d8e6886-ccde-4205-be36-8ec4b90bd1b8" >
			<when expression="#[['331960', '2684444', '747448'] contains vars.mockFoodId]" >
				<munit:set-event doc:name="Set Event" doc:id="ee3fc7e1-63ed-4059-9a12-b1bd26a26e58" cloneOriginalEvent="true" >
					<munit:payload value='#[MunitTools::getResourceAsString("payloads/food_" ++ vars.mockFoodId ++ ".json")]' mediaType="application/json" />
					<munit:attributes value="#[{statusCode: 200}]" />
				</munit:set-event>
			</when>
			<otherwise >
				<raise-error doc:name="Raise error" doc:id="032507b0-6648-4fbf-b120-7a5bcd4f56ab" type="ANY" description="Unexpected foodId in MUnit mock" />
			</otherwise>
		</choice>
	</flow>

