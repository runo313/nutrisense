<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<flow name="orchestrate-daily-insight-flow" doc:id="1ecbc928-7b1b-4e55-a7d9-737b68406a3c" >
		<ee:transform doc:name="set vars" doc:id="69e567dd-848d-4b4a-a64b-b83af3b04bb9">
			<ee:variables>
				<ee:set-variable variableName="userId"><![CDATA[attributes.uriParams.'userId']]></ee:set-variable>
				<ee:set-variable variableName="correlationId"><![CDATA[%dw 2.0
output application/java
---
correlationId]]></ee:set-variable>
				<ee:set-variable variableName="date"><![CDATA[%dw 2.0
output application/java
---
(attributes.queryParams.date as Date) default now() as Date]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<logger level="INFO" doc:name="START" doc:id="9882c033-1ea2-4510-8d00-3e9aa29305c4" message='#[%dw 2.0&#10;output application/json&#10;import buildLog from dwl::log&#10;var message ={&#10;	userId: vars.userId&#10;}&#10;---&#10;buildLog("INFO","Daily Insights Process Started",message,vars.correlationId, "orchestrate-daily-insight-flow")]' />
		<flow-ref doc:name="fetch-user-profile-subflow" doc:id="6fd28a75-dbc3-4468-9629-e377c507bd66" name="fetch-user-profile-subflow" />
		<scatter-gather doc:name="Scatter-Gather" doc:id="a2f39c02-f85f-4c9b-a7b1-ec161b0a0651">
			<route>
				<flow-ref doc:name="fetch-wearable-data-subflow" doc:id="7b0bb422-d73d-46b5-87eb-f8b6350ba9c7" name="fetch-wearable-data-subflow" />
			</route>
			<route>
				<flow-ref doc:name="fetch-meals-and-nutrition-subflow" doc:id="54adf44c-fc00-4073-80e2-ce93112e3d31" name="fetch-meals-and-nutrition-subflow" />
			</route>
		</scatter-gather>
		<flow-ref doc:name="evaluate-daily-insight-subflow" doc:id="cfcb8c06-a559-451d-b31b-af2074e446e8" name="evaluate-daily-insight-subflow"/>
		<logger level="INFO" doc:name="Evaluation Complete" doc:id="733c5ef3-e6c4-4c95-ab01-9993cb6a7c6f" message='#[%dw 2.0&#10;output application/json&#10;import buildLog from dwl::log&#10;var message ={&#10;	userId: vars.userId,&#10;	date: vars.date&#10;}&#10;---&#10;buildLog("INFO","Evaluation Complete",message,vars.correlationId, "orchestrate-daily-insight-flow")]' />
	</flow>
</mule>
