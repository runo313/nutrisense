<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<error-handler name="error-handler" doc:id="582daa30-ef6d-4933-b240-7ef71fac99fd" >
		<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="6f0441a4-95bf-4bb9-b4cc-1aca81b1b545" type="MULE:COMPOSITE_ROUTING">
			<logger level="ERROR" doc:name="Error" doc:id="f2feed4d-3139-4fb3-bd7d-04b50d1ec8b8" message='#[%dw 2.0&#10;output application/json&#10;var logMessage = {&#10;	userId: vars.userId,&#10;	error: error.description&#10;}&#10;import buildLog from dwl::log&#10;---&#10;buildLog("ERROR","Profile fetch failed.",logMessage,vars.correlationId , vars.flowName)]' />
			<ee:transform doc:name="User Profile error" doc:id="ddafac3c-621c-4f09-ba11-3e1b337aa809">
				<ee:message>
					<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  code: "DAILY-INSIGHT-503",
  message: "Unable to retrieve complete user profile data.",
  correlationId: correlationId,
  timestamp: now() as String {format: "yyyy-MM-dd'T'HH:mm:ssXXX"},
  originLayer: "process"
}
]]></ee:set-payload>
				</ee:message>
				<ee:variables>
					<ee:set-variable variableName="httpStatus"><![CDATA[503]]></ee:set-variable>
				</ee:variables>
			</ee:transform>
		</on-error-propagate>
	</error-handler>
</mule>
