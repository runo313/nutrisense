		<munit:execution >
			<munit:set-event doc:name="Set Event" doc:id="77ba8a39-57d4-41d2-83b1-9f16d04bb473" >
				<munit:attributes value='#[%dw 2.0&#10;output application/java&#10;---&#10;{&#10;	uriParams: {&#10;		userId: "runo313"&#10;	},&#10;	queryParams: {&#10;		date: "2026-09-14"&#10;	}&#10;}]' />
			</munit:set-event>
			<flow-ref doc:name="Flow Reference" doc:id="6bcd0773-a445-4ac2-ab4b-d6dc0c2bb052" name="get:\insights\daily\(userId):daily-insight-process-api-config"/>
		</munit:execution>
		<munit:validation >
			<munit-tools:assert-that doc:name="Assert that http status 200" doc:id="ac1073d3-e1db-4c49-8dfc-1329956138c0" expression="#[vars.httpStatus]" is="#[MunitTools::equalTo(200)]" />
			<munit-tools:assert-that doc:name="Assert that Meals Logged is True" doc:id="84946ac9-181b-47ae-afc4-ff32509196b3" is="#[MunitTools::equalTo(true)]" message="Meals Logged should be true" expression="#[payload.data_completeness.meals_logged]"/>
			<munit-tools:assert-that doc:name="Assert that Nutrition Resolved is True" doc:id="ee9789cc-b67d-4e7a-94c4-de1453a19bec" message="Nutrition Resolved should be true" expression="#[payload.data_completeness.nutrition_resolved]" is="#[MunitTools::equalTo(true)]" />
			<munit-tools:assert-that doc:name="Assert that Wearable Data is True" doc:id="f71a524b-1932-4eef-9f8f-f48eee7c072b" message="Wearable Data should be true" expression="#[payload.data_completeness.wearable_daily_data_present]" is="#[MunitTools::equalTo(true)]" />
			<munit-tools:assert-that doc:name="Assert that Wearable Baseline is True" doc:id="f8c8aa40-b4b2-490f-85a5-5110eb35a412" message="Wearable Baseline should be true" expression="#[payload.data_completeness.wearable_baseline_available]" is="#[MunitTools::equalTo(true)]" />
			<munit-tools:assert-that doc:name="Assert Calories Status" doc:id="b7b15e6a-4199-422a-9296-10d07ac81adb" message="Calories satus should be soft warning" expression="#[payload.dimension_status.calories.status]" is='#[MunitTools::equalTo("hard_flag")]' />
			<munit-tools:assert-that doc:name="Assert Total Calories " doc:id="e66769e7-3982-4c66-b29e-850b5fc2ac7e" message="calories should be close to 352" expression="#[payload.nutrition_detail.total_calories]" is='#[MunitTools::closeTo(352.87825, 0.5)]' />
			<munit-tools:assert-that doc:name="Assert Macros Status" doc:id="b6549ec8-23ca-4f5d-8a41-74fb8f7d9988" message="Macros satus should be hard_flag" expression="#[payload.dimension_status.macros.status]" is='#[MunitTools::equalTo("hard_flag")]' />
			<munit-tools:assert-that doc:name="Assert that micro status is null " doc:id="92ed3400-7449-45a0-91cf-5b4cbaf283ce" message="Micro Status should be null " expression="#[payload.dimension_status.micros.status]" is="#[MunitTools::nullValue()]"/>
			<munit-tools:assert-that doc:name="Assert that condition context " doc:id="5641b207-8081-4e3e-9704-99642f6129fe" message="Condition context should be anemia" expression="#[payload.nutrition_detail.micronutrients[0].condition_context]" is='#[MunitTools::equalTo("anemia")]' />
			<munit-tools:assert-that doc:name="Assert sleep floor " doc:id="bd12b78d-775f-4330-9572-4bffe4bc26ae" message="Sleep Floor should be true" expression="#[payload.biometric_detail.sleep.floor_applied]" is='#[MunitTools::equalTo(true)]' />
			<munit-tools:assert-that doc:name="Assert Recovery Status" doc:id="bdc7a718-772a-443f-92d8-a943dd80b6fb" is="#[MunitTools::equalTo('soft_warning')]" message="Recovery status should be soft warning" expression="#[payload.biometric_detail.recovery.status]"/>
			<munit-tools:assert-that doc:name="Assert Cross Signal Key" doc:id="3aa7d047-5942-406e-aba8-b068d31ebd97" is='#[MunitTools::equalTo("recovery_stress")]' message="Cross signal key should be recovery stress" expression="#[payload.cross_signal[0].key]"/>
		</munit:validation>
	</munit:test>
	<munit:test name="should_produce_full_insight_with_flagged_dimensions_when_not_all_data_available" doc:id="6c7f0103-0d05-4f7e-bb36-298ad67c6456" >
