	<munit:config name="daily-insight-evaluation-suite.xml" />
	<munit:test name="should_produce_full_insight_with_flagged_dimensions_when_all_data_available" doc:id="c293337d-9eab-4abb-ad79-e689970672d6">
		<munit:behavior >
			<munit-tools:mock-when doc:name="Mock GET Profiles" doc:id="13dd0e2d-c863-4c34-933d-afbf916133d6" processor="http:request">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="10fbcfe7-ef5d-472a-9184-047cf2f00658" attributeName="doc:id" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value='#[MunitTools::getResourceAsString("payloads/profile.json") read "application/json"]' />
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when doc:name="Mock GET Meals" doc:id="a551de46-7c31-4420-a6f2-4db89acabe89" processor="http:request" >
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="feb9df4a-fa6c-47b3-9896-2b519a192a89" attributeName="doc:id" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value='#[MunitTools::getResourceAsString("payloads/meals.json") read "application/json"]' />
					<munit-tools:attributes value="#[{&#10;	statusCode: 200&#10;}]" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when doc:name="Mock GET Food747448" doc:id="9f4a0448-89f2-4a7a-8955-bea342f581ac" processor="http:request" >
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="747448" attributeName="foodId" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value='#[MunitTools::getResourceAsString("payloads/food_747448.json") read "application/json"]' />
					<munit-tools:attributes value='#[{"statusCode": 200}]' />
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when doc:name="Mock GET Food2684444" doc:id="3fc5c6cd-b5c7-4da7-9922-d2d4c37d11eb" processor="http:request" >
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="2684444" attributeName="foodId" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value='#[MunitTools::getResourceAsString("payloads/food_2684444.json") read "application/json"]' />
					<munit-tools:attributes value='#[{"statusCode": 200}]' />
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when doc:name="Mock GET Food331960" doc:id="6edc3e1a-87f0-4e6e-b401-99cdcd535073" processor="http:request" >
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="331960" attributeName="foodId" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value='#[MunitTools::getResourceAsString("payloads/food_331960.json") read "application/json"]' />
					<munit-tools:attributes value='#[{"statusCode": 200}]' />
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when doc:name="Mock GET wearable data" doc:id="caf622f9-2479-427c-8d26-72d9a731b164" processor="http:request">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="ac1135b7-ae94-4339-8671-14c27256bc18" attributeName="doc:id" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:variables >
						<munit-tools:variable key="dailyWearable" value='#[MunitTools::getResourceAsString("payloads/wearables.json") read "application/json"]' mediaType="application/java" />
					</munit-tools:variables>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when doc:name="Mock GET wearable Summary" doc:id="a787f9a0-4883-4738-908f-816c119bb34a" processor="http:request" >
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="b0a34b89-72ef-4809-8398-30edfe6074bf" attributeName="doc:id" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value='#[MunitTools::getResourceAsString("payloads/summary.json") read "application/json"]' mediaType="application/java" />
					<munit-tools:variables >
						<munit-tools:variable key="summaryWearable" value='#[MunitTools::getResourceAsString("payloads/summary.json") read "application/json"]' mediaType="application/java" />
					</munit-tools:variables>
