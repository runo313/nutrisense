<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:validation="http://www.mulesoft.org/schema/mule/validation" xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
http://www.mulesoft.org/schema/mule/validation http://www.mulesoft.org/schema/mule/validation/current/mule-validation.xsd">
	<sub-flow name="extract-user-id-subflow" doc:id="7c196a75-4a87-4830-88a5-d93b09798a55" >
		<set-variable value="#[%dw 2.0&#10;output application/json&#10;---&#10;authentication.properties.claims.sub]" doc:name="User Id" doc:id="5db0f9b0-9016-4f6f-9700-d42503eb8c97" variableName="userId"/>
		<logger level="INFO" doc:name="User Id Extracted" doc:id="c5af4d50-fde9-4ab5-b1e5-2807e97b752a" message='#[%dw 2.0&#10;output application/json&#10;import buildLog from dwl::log&#10;var message ={&#10;	userId: vars.userId,&#10;}&#10;---&#10;buildLog("INFO","User ID extracted",message,vars.correlationId, "extract-user-id-subflow")]' />
	</sub-flow>
	<sub-flow name="personal-dashboard-exp-apiSub_Flow" doc:id="790a84f2-dc79-49db-8fbf-487be755be3a" >
		<try doc:name="Try" doc:id="9d5e414c-4137-4f6a-87f5-7933df780879" >
			<http:request doc:name="Get User Timezone" doc:id="e22494f3-a017-495c-8c15-acc5ed1c1042" config-ref="USERPROFILE_SAPI_HTTP_CONFIG" path="api/v1/user-profile-sapi/profiles/{userId}/preferences" responseTimeout="${nutrisense.sapi.timeout}" target="timezone" targetValue="#[payload.timezone]" >
				<http:headers ><![CDATA[#[output application/java
---
{
	"client_id" : Mule::p('nutrisense.sapi.clientId'),
	"client_secret": Mule::p('secure::nutrisense.sapi.clientSecret')
}]]]></http:headers>
				<http:uri-params ><![CDATA[#[output application/java
---
{
	"userId" : vars.userId
}]]]></http:uri-params>
			</http:request>
			<error-handler >
				<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="1384c587-1601-4153-8dca-8e6a8e8be6db" type="ANY" >
					<logger level="ERROR" doc:name="Preferences Retrieval Error" doc:id="4ce452a9-185d-470d-b5a3-9ce73853c405" message='#[%dw 2.0&#10;output application/json&#10;var logMessage = {&#10;	userId: vars.userId,&#10;	code: error.errorMessage.payload.code,&#10;	message: error.errorMessage.payload.message&#10;}&#10;import buildLog from dwl::log&#10;---&#10;buildLog("ERROR","timezone not set defaulting to UTC",logMessage,vars.correlationId , vars.flowName)]' />
				</on-error-continue>
			</error-handler>
		</try>
		<set-variable value="#[vars.timezone default 'UTC']" doc:name="Set Timezone" doc:id="7e26a95b-1f9e-47e5-86ec-22d420d3becb" variableName="timezone" />
		<ee:transform doc:name="Transform Message" doc:id="cccdfead-97ee-4864-ae2f-f69b95e51f73">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/java
var timezone = vars.timezone
var current = (now() >> timezone) as String {format: "HH:mm"}
var actual = "18:00" as String {format: "HH:mm"}
---
if(vars.date == (now() as Date))(current > actual) else false]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<validation:is-false doc:name="Is false" doc:id="9959245b-af26-4f32-a8ce-59e74746cc9e" message="Today's insight report is available after 6:00 PM in your configured timezone." expression="#[payload]"/>
	</sub-flow>
</mule>
