		<munit:behavior>
			<munit-tools:mock-when doc:id="12cec4fe-fad9-4b4c-a421-0a3009c3b046" doc:name="Mock set client Id" processor="set-variable">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:id" whereValue="5db0f9b0-9016-4f6f-9700-d42503eb8c97"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:variables>
						<munit-tools:variable key="userId" mediaType="application/java" value="#[&quot;c3f1a7e2-5b84-4d1e-9a60-2f7d8b9e4a10&quot;]"/>
