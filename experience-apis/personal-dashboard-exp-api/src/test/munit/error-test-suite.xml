				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when doc:id="8d2d89ff-48a4-4913-aafe-2bd9cf6187ac" doc:name="Mock Retreive Timezone" processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:id" whereValue="b2a46508-f83c-442b-9ceb-f078caeb1870"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:variables>
						<munit-tools:variable key="timezone" value="#[&quot;America/New_York&quot;]"/>
					</munit-tools:variables>
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<munit:set-event doc:id="6ca7d3b1-aeac-4dc2-abb4-18fde14ee99d" doc:name="Set Event">
				<munit:attributes value="#[%dw 2.0&#10;output application/java&#10;---&#10;{&#10; queryParams: {&#10;  date: now() as Date&#10; }&#10;}]"/>
			</munit:set-event>
			<flow-ref doc:id="db85527d-d439-4635-9843-3956a5954beb" doc:name="Flow Reference" name="get:\me\insights\daily:personal-dashboard-experience-api-config"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:id="ad76148b-f9fb-40fc-896f-be76d7096d8c" doc:name="Assert that http status 409" expression="#[vars.httpStatus]" is="#[MunitTools::equalTo(409)]"/>
		</munit:validation>
