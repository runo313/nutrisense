		<munit:execution>
			<munit:set-event doc:id="ff0c2c61-d219-4fcc-9105-5e8963565a71" doc:name="Set Event">
				<munit:payload value="#[%dw 2.0&#10;output application/java&#10;---&#10;{&#10;  isActive: false,&#10;  achievedAt: &quot;2026-08-18T08:00:00-04:00&quot;&#10;}]"/>
				<munit:attributes value="#[%dw 2.0&#10;output application/java&#10;---&#10;{&#10;  uriParams: {&#10;    goalId: &quot;e275b95b-bcfc-43dc-a2f0-3a743365a831&quot;&#10;  }&#10;}]"/>
			</munit:set-event>
			<flow-ref doc:id="b66edaee-7b02-4ad2-98c0-a6830f88fbfa" doc:name="patch:\me\goals\(goalId)" name="patch:\me\goals\(goalId):application\json:personal-dashboard-experience-api-config"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:id="4a281ca2-1f8b-4951-9017-e1268a4cdf6b" doc:name="Assert that http status 404" expression="#[vars.httpStatus]" is="#[MunitTools::equalTo(404)]"/>
			<munit-tools:assert-that doc:id="b3548781-ca45-42c0-95b7-9d8dd453c019" doc:name="Assert Error Code" expression="#[payload.code]" is="#[MunitTools::equalTo(&quot;PERSONAL-DASHBOARD-404&quot;)]" message="activity baseline is incorrect"/>
		</munit:validation>
	</munit:test>
