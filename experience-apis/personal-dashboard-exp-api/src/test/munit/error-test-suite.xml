	<munit:test doc:id="020de4ca-fe0f-4e9d-bdeb-269dafdd07cf" name="should_return_404_when_patch_goal">
		<munit:behavior>
			<munit-tools:mock-when doc:id="1b10b20d-a0a0-45c0-95ad-27b9aeb12e84" doc:name="Mock set client Id" processor="set-variable">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:id" whereValue="5db0f9b0-9016-4f6f-9700-d42503eb8c97"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:variables>
						<munit-tools:variable key="userId" mediaType="application/java" value="#[&quot;c3f1a7e2-5b84-4d1e-9a60-2f7d8b9e4a10&quot;]"/>
					</munit-tools:variables>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when doc:id="9712a955-ec69-46f1-b3af-bdf500cb1f5a" doc:name="Mock Update Goal" processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:id" whereValue="11686a7b-5724-4f8a-9b17-7e0d865e31c2"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:error typeId="HTTP:NOT_FOUND"/>
